# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem

# editors
.idea/
*.swp
*.swo

# debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python
.venv*/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# local FLUX image pipeline: working files only, the site ships just the finished images.
# /scripts/ is ignored wholesale, so drop that line before adding a script meant for the repo.
.pipeline/
/scripts/
/docs/flux-style-*.md
/.cursor/skills/flux-style-images/
/public/images/research/ai-visibility/style-system/
/public/images/research/ai-visibility/*-reference-study*.jpg
/public/images/research/ai-visibility/image.png
